# Gemini API key (server-side only, never committed)
GEMINI_API_KEY=

# Comma-separated list of Gemini model IDs to use
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Maximum number of AI requests per day
GEMINI_DAILY_BUDGET=200

# Allowed CORS origin URL (omit for same-origin only)
ALLOWED_ORIGIN=
