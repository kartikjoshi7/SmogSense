# Settings read by src/server/config.ts. Copy to .env.local and fill in what you need; every
# variable is optional, and its default lives in config.ts only.

# Gemini API key (server-side only, never committed). Without it the app uses standard guidance.
GEMINI_API_KEY=

# Comma-separated Gemini model ids, tried in order
GEMINI_MODELS=

# Most Gemini model calls per UTC day on one server instance (one request may make several)
GEMINI_DAILY_BUDGET=

# Thinking level for the models: OFF, MINIMAL or LOW
GEMINI_THINKING_LEVEL=

# Origin allowed to call the API from another site, as a full URL; leave empty for same-origin only
ALLOWED_ORIGIN=
